<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Attendance | Leave Portal</title>
  <link rel="stylesheet" href="/output.css">

  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
</head>
<body class="bg-gray-100 min-h-screen">

  <nav class="bg-white shadow px-6 py-4 flex justify-between items-center">
    <h1 class="text-xl font-bold text-blue-600">Leave Portal</h1>
    <div class="flex items-center gap-4">
      <a href="/employee/dashboard" class="text-sm text-blue-600 hover:underline font-medium">Leave</a>
      <span class="text-sm text-gray-600">Hello, <%= user.name %></span>
      <a href="/logout" class="text-sm text-red-500 hover:underline">Logout</a>
    </div>
  </nav>

  <div class="max-w-2xl mx-auto mt-8 px-4">

    <div class="bg-white rounded-xl shadow overflow-hidden">

      <div id="map" style="height: 250px; width: 100%;"></div>

      <div class="p-6">
        <h2 class="text-xl font-bold text-gray-800">Hello, <%= user.name %>!</h2>
        <p id="current-date" class="text-gray-400 text-sm mt-1"></p>
        <p id="current-time" class="text-gray-400 text-sm"></p>

        <div class="mt-4">
          <p class="text-sm font-semibold text-gray-700">Location</p>
          <p id="address" class="text-sm text-gray-500 mt-1">Detecting your location...</p>
        </div>

        <div class="grid grid-cols-2 gap-4 mt-4">
          <div>
            <p class="text-sm font-semibold text-gray-700">Shift In Time</p>
            <p class="text-lg font-bold text-gray-800"><%= shiftStart %></p>
          </div>
          <div>
            <p class="text-sm font-semibold text-gray-700">Shift Out Time</p>
            <p class="text-lg font-bold text-gray-800"><%= shiftEnd %></p>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4 mt-4">
          <div>
            <p class="text-sm font-semibold text-gray-700">Punch In</p>
            <p class="text-lg font-bold text-green-600">
              <%= record && record.punchIn ? record.punchIn : '--' %>
            </p>
          </div>
          <div>
            <p class="text-sm font-semibold text-gray-700">Punch Out</p>
            <p class="text-lg font-bold text-red-500">
              <%= record && record.punchOut ? record.punchOut : '--' %>
            </p>
          </div>
        </div>

        <% if (record) { %>
          <div class="mt-4">
            <% if (record.status === 'late') { %>
              <span class="bg-yellow-100 text-yellow-700 px-3 py-1 rounded-full text-xs font-medium">Late</span>
            <% } else { %>
              <span class="bg-green-100 text-green-700 px-3 py-1 rounded-full text-xs font-medium">On Time</span>
            <% } %>
          </div>
        <% } %>

        <div class="mt-6">
          <% if (!record) { %>
            <form action="/attendance/punchin" method="POST" id="punchInForm">
              <input type="hidden" name="lat" id="lat" />
              <input type="hidden" name="lng" id="lng" />
              <input type="hidden" name="address" id="addressInput" />
              <button
                type="submit"
                class="w-full bg-blue-600 text-white py-3 rounded-lg font-semibold hover:bg-blue-700 transition"
              >
                Mark Attendance — Punch In
              </button>
            </form>
          <% } else if (record.punchIn && !record.punchOut) { %>
            <form action="/attendance/punchout" method="POST">
              <button
                type="submit"
                class="w-full bg-red-500 text-white py-3 rounded-lg font-semibold hover:bg-red-600 transition"
              >
                Punch Out
              </button>
            </form>
          <% } else if (record.punchIn && record.punchOut) { %>
            
            <div class="w-full bg-gray-100 text-gray-500 py-3 rounded-lg text-center font-semibold">
                Attendance Done for Today
            </div>
          <% } %>
        </div>

      </div>
    </div>
  </div>

  <script>
  // ---LIVE CLOCK---
  function updateTime() {
    const now = new Date();
    document.getElementById('current-date').textContent = now.toDateString();
    document.getElementById('current-time').textContent = now.toLocaleTimeString('en-US', {
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: true
    });
  }
  updateTime();
  setInterval(updateTime, 1000);

  
  const map = L.map('map');
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '© OpenStreetMap contributors'
  }).addTo(map);

  map.setView([28.6139, 77.2090], 12);

  setTimeout(() => {
    if (navigator.geolocation) {
      navigator.geolocation.getCurrentPosition(async (position) => {
        const lat = position.coords.latitude;
        const lng = position.coords.longitude;

        map.setView([lat, lng], 16);
        L.marker([lat, lng]).addTo(map)
          .bindPopup('You are here')
          .openPopup();

        const latInput = document.getElementById('lat');
        const lngInput = document.getElementById('lng');
        if (latInput) latInput.value = lat;
        if (lngInput) lngInput.value = lng;

        try {
          const response = await fetch(
            `https://nominatim.openstreetmap.org/reverse?lat=${lat}&lon=${lng}&format=json`,
            { headers: { 'Accept-Language': 'en' } }
          );
          const data = await response.json();
          const address = data.display_name || 'Address not found';
          document.getElementById('address').textContent = address;
          const addressInput = document.getElementById('addressInput');
          if (addressInput) addressInput.value = address;
        } catch (err) {
          document.getElementById('address').textContent = 'Could not fetch address';
        }

      }, () => {
        document.getElementById('address').textContent = 'Location access denied';
      });
    }
  }, 500);
</script>

</body>
</html>