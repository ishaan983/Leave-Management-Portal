<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Dashboard | Leave Portal</title>
  <link rel="stylesheet" href="/output.css">
</head>
<body class="min-h-screen bg-slate-50 text-slate-800">
  <% const pendingLeaves = leaves.filter(leave => leave.status === 'pending').length; %>
  <% const approvedLeaves = leaves.filter(leave => leave.status === 'approved').length; %>
  <% const rejectedLeaves = leaves.filter(leave => leave.status === 'rejected').length; %>

  <header class="border-b border-slate-200 bg-white">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
      <a href="/employee/dashboard">
        <p class="text-base font-bold text-slate-900">Leave Portal</p>
        <p class="text-xs font-medium text-slate-500">Employee workspace</p>
      </a>

      <div class="flex items-center gap-3 sm:gap-5">
        <a href="/attendance" class="hidden text-sm font-semibold text-blue-600 transition hover:text-blue-700 sm:block">Attendance</a>
        <div class="hidden text-right sm:block">
          <p class="text-sm font-semibold text-slate-800"><%= user.name %></p>
          <p class="text-xs text-slate-500">Employee</p>
        </div>
        <a href="/logout" class="rounded-lg border border-slate-200 px-3 py-2 text-sm font-semibold text-slate-600 transition hover:border-red-200 hover:bg-red-50 hover:text-red-600">Logout</a>
      </div>
    </div>
  </header>

  <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <section class="mb-8 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <p class="mb-1 text-sm font-semibold text-blue-600"></p>
        <h1 class="text-3xl font-bold tracking-tight text-slate-900">Hello, <%= user.name.split(' ')[0] %>.</h1>
        <p class="mt-2 text-sm text-slate-500"></p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row">
        <a href="/attendance" class="inline-flex items-center justify-center rounded-lg border border-blue-200 px-4 py-2.5 text-sm font-semibold text-blue-700 transition hover:bg-blue-50 sm:hidden">Attendance</a>
        <a href="/employee/apply" class="inline-flex items-center justify-center rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-blue-700">Apply for leave</a>
      </div>
    </section>

    <section aria-label="Leave request summary" class="grid gap-4 sm:grid-cols-3">
      <div class="rounded-2xl border border-blue-100 bg-blue-600 p-5 text-white shadow-sm">
        <p class="text-sm font-medium text-blue-100">Total requests</p>
        <p class="mt-4 text-4xl font-bold"><%= leaves.length %></p>
        <p class="mt-1 text-xs font-medium text-blue-100">All submitted requests</p>
      </div>
      <div class="rounded-2xl border border-amber-100 bg-white p-5 shadow-sm">
        <p class="text-sm font-medium text-slate-500">Awaiting approval</p>
        <div class="mt-4 flex items-end justify-between">
          <p class="text-4xl font-bold text-amber-500"><%= pendingLeaves %></p>
          <span class="text-xs font-semibold text-amber-600">Pending</span>
        </div>
      </div>
      <div class="rounded-2xl border border-emerald-100 bg-white p-5 shadow-sm">
        <p class="text-sm font-medium text-slate-500">Approved requests</p>
        <div class="mt-4 flex items-end justify-between">
          <p class="text-4xl font-bold text-emerald-600"><%= approvedLeaves %></p>
          <span class="text-xs font-semibold text-emerald-600"><%= rejectedLeaves %> rejected</span>
        </div>
      </div>
    </section>

    <section class="mt-10">
      <div class="mb-5 flex flex-col justify-between gap-3 sm:flex-row sm:items-center">
        <div>
          <h2 class="text-xl font-bold text-slate-900">My leave requests</h2>
          <p class="mt-1 text-sm text-slate-500">Your newest requests appear first.</p>
        </div>
        <% if (pendingLeaves > 0) { %>
          <span class="w-fit rounded-full bg-amber-50 px-3 py-1.5 text-xs font-semibold text-amber-700"><%= pendingLeaves %> awaiting approval</span>
        <% } %>
      </div>

      <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <% if (leaves.length === 0) { %>
          <div class="px-6 py-16 text-center">
            <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-blue-50 text-xl text-blue-600">+</div>
            <h3 class="mt-4 text-base font-semibold text-slate-800">No leave requests yet</h3>
            <p class="mt-1 text-sm text-slate-500"></p>
            <a href="/employee/apply" class="mt-5 inline-flex rounded-lg bg-blue-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-blue-700">Apply leave</a>
          </div>
        <% } else { %>
          <div class="overflow-x-auto">
            <table class="min-w-[760px] w-full text-left text-sm">
              <thead class="border-b border-slate-200 bg-slate-50 text-xs font-semibold uppercase tracking-wide text-slate-500">
                <tr>
                  <th class="px-6 py-4">Leave type</th>
                  <th class="px-6 py-4">Dates</th>
                  <th class="px-6 py-4">Reason</th>
                  <th class="px-6 py-4">Status</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <% leaves.forEach(leave => { %>
                  <% const statusStyle = leave.status === 'pending'
                    ? 'bg-amber-50 text-amber-700 ring-amber-600/20'
                    : leave.status === 'approved'
                      ? 'bg-emerald-50 text-emerald-700 ring-emerald-600/20'
                      : 'bg-rose-50 text-rose-700 ring-rose-600/20'; %>
                  <tr class="transition hover:bg-slate-50/80">
                    <td class="px-6 py-4">
                      <span class="rounded-md bg-blue-50 px-2 py-1 text-xs font-semibold capitalize text-blue-700"><%= leave.leaveType %></span>
                    </td>
                    <td class="whitespace-nowrap px-6 py-4 text-slate-600">
                      <p><%= leave.startDate.toDateString() %></p>
                      <p class="mt-0.5 text-xs text-slate-400">to <%= leave.endDate.toDateString() %></p>
                    </td>
                    <td class="max-w-sm px-6 py-4 text-slate-600">
                      <p class="truncate" title="<%= leave.reason %>"><%= leave.reason %></p>
                    </td>
                    <td class="px-6 py-4">
                      <span class="inline-flex rounded-full px-2.5 py-1 text-xs font-semibold ring-1 ring-inset <%= statusStyle %>">
                        <%= leave.status.charAt(0).toUpperCase() + leave.status.slice(1) %>
                      </span>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </section>
  </main>
</body>
</html>
