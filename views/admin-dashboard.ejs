<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard | Leave Portal</title>
  <link rel="stylesheet" href="/output.css">
</head>
<body class="bg-gray-100 min-h-screen">
  <nav class="bg-white shadow px-6 py-4 flex justify-between items-center">
    <h1 class="text-xl font-bold text-blue-600">Admin Dashboard</h1>
    <div class="flex items-center gap-4">
      <span class="text-sm text-gray-600">Hello, <%= user.name %></span>
      <a href="/logout" class="text-sm text-red-500 hover:underline">Logout</a>
    </div>
  </nav>

  <div class="max-w-6xl mx-auto mt-8 px-4">

    <div class="flex justify-between items-center mb-6">
      <h2 class="text-2xl font-bold text-gray-800">All Leave Requests</h2>
      <span class="text-sm text-gray-500">Total: <%= leaves.length %> requests</span>
    </div>

    <div class="bg-white rounded-xl shadow overflow-hidden">
      <% if (leaves.length === 0) { %>
        <div class="text-center text-gray-500 py-12">
          No leave requests found.
        </div>
      <% } else { %>
        <table class="w-full text-sm">
          <thead class="bg-gray-50 text-gray-600 uppercase text-xs">
            <tr>
              <th class="px-6 py-3 text-left">Employee</th>
              <th class="px-6 py-3 text-left">Email</th>
              <th class="px-6 py-3 text-left">Type</th>
              <th class="px-6 py-3 text-left">Start Date</th>
              <th class="px-6 py-3 text-left">End Date</th>
              <th class="px-6 py-3 text-left">Reason</th>
              <th class="px-6 py-3 text-left">Status</th>
              <th class="px-6 py-3 text-left">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% leaves.forEach(leave => { %>
              <tr class="hover:bg-gray-50">
                <td class="px-6 py-4 font-medium"><%= leave.employee.name %></td>
                <td class="px-6 py-4 text-gray-500"><%= leave.employee.email %></td>
                <td class="px-6 py-4 capitalize"><%= leave.leaveType %></td>
                <td class="px-6 py-4"><%= leave.startDate.toDateString() %></td>
                <td class="px-6 py-4"><%= leave.endDate.toDateString() %></td>
                <td class="px-6 py-4"><%= leave.reason %></td>
                <td class="px-6 py-4">
                  <% if (leave.status === 'pending') { %>
                    <span class="bg-yellow-100 text-yellow-700 px-2 py-1 rounded-full text-xs font-medium">Pending</span>
                  <% } else if (leave.status === 'approved') { %>
                    <span class="bg-green-100 text-green-700 px-2 py-1 rounded-full text-xs font-medium">Approved</span>
                  <% } else { %>
                    <span class="bg-red-100 text-red-700 px-2 py-1 rounded-full text-xs font-medium">Rejected</span>
                  <% } %>
                </td>

                <td class="px-6 py-4">
                  <% if (leave.status === 'pending') { %>
                    <div class="flex gap-2">
                      <form action="/admin/leave/<%= leave._id %>/approve" method="POST">
                        <button
                          type="submit"
                          class="bg-green-500 text-white px-3 py-1 rounded text-xs font-semibold hover:bg-green-600 transition"
                        >
                          Approve
                        </button>
                      </form>
                      <form action="/admin/leave/<%= leave._id %>/reject" method="POST">
                        <button
                          type="submit"
                          class="bg-red-500 text-white px-3 py-1 rounded text-xs font-semibold hover:bg-red-600 transition"
                        >
                          Reject
                        </button>
                      </form>
                    </div>
                  <% } else { %>
                    <span class="text-gray-400 text-xs">No action needed</span>
                  <% } %>
                </td>

              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  

<div class="mt-10">
  <h2 class="text-2xl font-bold text-gray-800 mb-6">Employee Attendance</h2>

  <div class="grid grid-cols-3 gap-4 mb-6">
    <div class="bg-white rounded-xl shadow p-6 text-center">
      <p class="text-sm text-gray-500 mb-1">Total Present</p>
      <p class="text-4xl font-bold text-green-600"><%= analytics.totalPresent %></p>
      <p class="text-xs text-gray-400 mt-1">Today</p>
    </div>
    <div class="bg-white rounded-xl shadow p-6 text-center">
      <p class="text-sm text-gray-500 mb-1">Total Late</p>
      <p class="text-4xl font-bold text-yellow-500"><%= analytics.totalLate %></p>
      <p class="text-xs text-gray-400 mt-1">Today</p>
    </div>
    <div class="bg-white rounded-xl shadow p-6 text-center">
      <p class="text-sm text-gray-500 mb-1">Total Absent</p>
      <p class="text-4xl font-bold text-red-500"><%= analytics.totalAbsent %></p>
      <p class="text-xs text-gray-400 mt-1">Today</p>
    </div>
  </div>

  
  <form method="GET" action="/admin/dashboard" class="flex items-end gap-6 mb-8">
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Filter by Date</label>
      <input
        type="date"
        name="date"
        value="<%= selectedDate %>"
        class="border border-gray-300 rounded-lg px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
      />
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">Filter by Status</label>
      <select
        name="status"
        class="border border-gray-300 rounded-lg px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
      >
        <option value="all" <%= selectedStatus === 'all' ? 'selected' : '' %>>All</option>
        <option value="present" <%= selectedStatus === 'present' ? 'selected' : '' %>>On Time</option>
        <option value="late" <%= selectedStatus === 'late' ? 'selected' : '' %>>Late</option>
      </select>
    </div>
    <div class="flex items-end">
      <button
        type="submit"
        class="bg-blue-600 text-white px-6 py-2 rounded-lg text-sm font-semibold hover:bg-blue-700 transition"
      >
        Apply Filter
      </button>
    </div>
  </form>

      <div class="bg-white rounded-xl shadow overflow-hidden">
        <% if (attendance.length === 0) { %>
          <div class="text-center py-10">
            <div class="text-4xl mb-3"></div>
            <h3 class="text-lg font-semibold text-gray-700">No attendance records</h3>
            <p class="text-sm text-gray-500 mt-1">
              No attendance found for the selected date.
            </p>
          </div>
        <% } else { %>
          <table class="w-full text-sm">
            <thead class="bg-gray-50 text-gray-600 uppercase text-xs">
              <tr>
                <th class="px-6 py-3 text-left">Employee</th>
                <th class="px-6 py-3 text-left">Email</th>
                <th class="px-6 py-3 text-left">Date</th>
                <th class="px-6 py-3 text-left">Punch In</th>
                <th class="px-6 py-3 text-left">Punch Out</th>
                <th class="px-6 py-3 text-left">Status</th>
                <th class="px-6 py-3 text-left">Location</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <% attendance.forEach(record => { %>
                <tr class="hover:bg-gray-50">
                  <td class="px-6 py-4 font-medium"><%= record.employee.name %></td>
                  <td class="px-6 py-4 text-gray-500"><%= record.employee.email %></td>
                  <td class="px-6 py-4"><%= record.date %></td>
                  <td class="px-6 py-4 text-green-600 font-medium">
                    <%= record.punchIn || '--' %>
                  </td>
                  <td class="px-6 py-4 text-red-500 font-medium">
                    <%= record.punchOut || '--' %>
                  </td>
                  <td class="px-6 py-4">
                    <% if (record.status === 'late') { %>
                      <span class="bg-yellow-100 text-yellow-700 px-2 py-1 rounded-full text-xs font-medium">Late</span>
                    <% } else { %>
                      <span class="bg-green-100 text-green-700 px-2 py-1 rounded-full text-xs font-medium">On Time</span>
                    <% } %>
                  </td>
                  <td class="px-6 py-4 text-gray-500 text-xs"><%= record.address || '--' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>
    </div>
  </div>

</body>
</html>